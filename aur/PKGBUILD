# Maintainer: Luigi <luigi@archlinux.org>
pkgname=yozora-git
pkgver=0.1.0
pkgrel=1
pkgdesc="Native Arch/Hyprland anime tracking, browsing, and playback client with Matugen theming and rqbit streaming"
arch=('x86_64' 'aarch64')
url="https://github.com/Luigichopper/Yozora"
license=('GPL-3.0-or-later')
depends=(
  'mpv'
  'gtk3'
  'webkit2gtk-4.1'
  'xdg-desktop-portal-hyprland'
)
optdepends=(
  'matugen: dynamic Material You color palette generation'
  'rqbit: embedded high-performance BitTorrent streaming daemon'
)
makedepends=('nodejs' 'npm' 'cargo' 'git')
provides=('yozora')
conflicts=('yozora' 'yozora-bin')
source=("git+https://github.com/Luigichopper/Yozora.git"
        "yozora.desktop")
sha256sums=('SKIP'
            'SKIP')

build() {
  cd "$srcdir/Yozora"
  npm install
  npm run build
  cd src-tauri
  cargo build --release --locked
}

package() {
  cd "$srcdir/Yozora"
  install -Dm755 "src-tauri/target/release/yozora" "$pkgdir/usr/bin/yozora"
  install -Dm644 "$srcdir/yozora.desktop" "$pkgdir/usr/share/applications/yozora.desktop"
  install -Dm644 "public/logo.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/yozora.svg"
}
